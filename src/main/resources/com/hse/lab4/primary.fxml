<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600.0" minWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hse.lab4.PrimaryController">
   <bottom>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblQuestion" maxHeight="Infinity" maxWidth="Infinity" style="-fx-font-size:18px; -fx-alignment: CENTER;" text="lblQuestionText" textAlignment="CENTER" wrapText="true" VBox.vgrow="ALWAYS" />
            <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
               <children>
                  <Button fx:id="btnAnswer1" maxHeight="Infinity" maxWidth="Infinity" onAction="#handleAnswerClick" prefHeight="40.0" text="btnAnswer1" userData="0" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" />
                  <Button fx:id="btnAnswer3" maxHeight="Infinity" maxWidth="Infinity" onAction="#handleAnswerClick" prefHeight="40.0" text="btnAnswer3" userData="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" />
                  <Button fx:id="btnAnswer2" maxHeight="Infinity" maxWidth="Infinity" onAction="#handleAnswerClick" prefHeight="40.0" text="btnAnswer2" userData="1" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
                  <Button fx:id="btnAnswer4" maxHeight="Infinity" maxWidth="Infinity" onAction="#handleAnswerClick" prefHeight="40.0" text="btnAnswer4" userData="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </padding>
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
                  <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
               </rowConstraints>
            </GridPane>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </bottom>
   <right>
      <VBox alignment="TOP_CENTER" maxHeight="400.0" maxWidth="140.0" minWidth="140.0" prefWidth="140.0" BorderPane.alignment="CENTER">
         <children>
            <ListView fx:id="lvMoney" editable="false" focusTraversable="false" mouseTransparent="true" />
         </children>
         <padding>
            <Insets left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
   <left>
      <VBox alignment="CENTER" maxHeight="400.0" maxWidth="140.0" minWidth="140.0" prefWidth="140.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnHelpFiftyFifty" onAction="#handleFiftyFiftyClick" prefWidth="120.0" text="50/50" />
            <Button fx:id="btnHelpFriend" onAction="#handleHelpFriendClick" prefWidth="120.0" text="Звонок другу" />
            <Button fx:id="btnHelpViewer" onAction="#handleHelpViewerClick" prefWidth="120.0" text="Помощь зала" />
            <Button fx:id="btnHelpMistake" onAction="#handleHelpMistakeClick" prefWidth="120.0" text="Одна ошибка" />
            <Button fx:id="btnHelpReplaceQuestion" onAction="#handleHelpReplaceQuestionClick" prefWidth="120.0" text="Замена вопроса" />
            <Region prefHeight="20.0" />
            <Button fx:id="btnTakeMoney" onAction="#handleTakeMoneyClick" prefWidth="120.0" text="Забрать деньги" />
         </children>
         <padding>
            <Insets left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="imagePane" maxHeight="400.0" minHeight="0.0" minWidth="0.0">
         <children>
            <ImageView fx:id="imgLogo" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER">
               <image>
                  <Image url="@splash.jpg" />
               </image>
            </ImageView>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </StackPane>
   </center>
   <top>
      <ButtonBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <buttons>
            <Button fx:id="btnUseTxt" onAction="#handleUseTxtClick" text="Вопросы из файла" />
            <Button fx:id="btnUseDb" onAction="#handleUseDBClick" text="Вопросы из БД" />
            <Button fx:id="btnUseAI" onAction="#handleUseAIClick" text="Вопросы от ИИ" />
            <Button fx:id="btnImport" onAction="#handleImportClick" text="Заполнить БД" />
            <Button fx:id="btnRecrods" onAction="#handleRecordsClick" text="Таблица рекордов" />
         </buttons>
         <padding>
            <Insets right="10.0" top="10.0" />
         </padding>
      </ButtonBar>
   </top>
</BorderPane>
